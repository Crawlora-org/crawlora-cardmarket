          "503": {
            "description": "Service Unavailable",
            "schema": {
              "$ref": "#/definitions/app.Response"
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "summary": "Discover Cardmarket catalogue categories and expansions",
        "tags": [
          "cardmarket"
        ]
      }
    },
    "/cardmarket/games": {
      "get": {
        "description": "Returns the exact observed public S3 price-guide IDs and whether singles/non-singles catalogue files are present. Product display names are not inferred from numeric IDs when the download index cannot provide a confirmed mapping.",
        "operationId": "cardmarket-games",
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
