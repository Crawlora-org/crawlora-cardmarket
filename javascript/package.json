{
  "name": "@crawlora-org/cardmarket",
  "version": "0.1.0",
  "description": "Crawlora Cardmarket API client with 5 endpoints for game and catalogue discovery, product lookup, and price guides",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=cardmarket-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-cardmarket/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "cardmarket", "cardmarket-api", "cardmarket-scraper", "cardmarket-data", "cardmarket-game-catalogue-discovery", "cardmarket-product-lookup", "cardmarket-price-guides"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-cardmarket",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
