{
  "name": "crawlora/cardmarket",
  "description": "Crawlora Cardmarket API client with 5 endpoints for game and catalogue discovery, product lookup, and price guides",
  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "cardmarket",
    "cardmarket-api",
    "cardmarket-scraper",
    "cardmarket-data",
    "cardmarket-game-catalogue-discovery",
    "cardmarket-product-lookup",
    "cardmarket-price-guides"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Crawlora\\Cardmarket\\": "php/src/Crawlora/Cardmarket/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlora\\Cardmarket\\Tests\\": "php/tests/"
    }
  },
  "scripts": {
    "test": "php php/tests/client_test.php"
  },
  "homepage": "https://crawlora.net/?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=cardmarket-php-homepage",
  "support": {
    "source": "https://github.com/Crawlora-org/crawlora-cardmarket",
    "docs": "https://crawlora.net/docs?utm_source=packagist&utm_medium=referral&utm_campaign=platform-clients&utm_content=cardmarket-php-api-docs"
  }
}
